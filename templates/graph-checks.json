{
  "version": 1,
  "test": {
    "argv": ["make", "check"],
    "timeout_seconds": 600
  },
  "precheck": {
    "argv": ["docker", "info"],
    "timeout_seconds": 10
  },
  "lint": {
    "argv": ["bash", "scripts/graph-lint.sh", "{file}"],
    "extensions": [".py", ".sh", ".ts", ".tsx", ".js", ".jsx", ".dart", ".swift", ".kt", ".go", ".cs"],
    "timeout_seconds": 60
  }
}
